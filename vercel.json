{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/cosmos-realestate run build",
  "outputDirectory": "artifacts/cosmos-realestate/dist/public",
  "installCommand": "echo skip",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
