{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/cosmos-realestate run build",
  "outputDirectory": "artifacts/cosmos-realestate/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
