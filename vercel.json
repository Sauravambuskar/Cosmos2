{
  "buildCommand": "pnpm --filter @workspace/cosmos-realestate run build",
  "outputDirectory": "artifacts/cosmos-realestate/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
